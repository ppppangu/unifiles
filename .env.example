# Unifiles Configuration
# =====================================
# 配置优先级：.env文件 > 环境变量 > 默认值
# Priority: .env file > Environment variables > Default values

# =====================================
# API 配置 - API Configuration
# =====================================

# 语言嵌入模型 - Language Embedding Models
# 第一个嵌入模型
UNIFILES_API_LANG_EMBED_0_NAME=""
UNIFILES_API_LANG_EMBED_0_URL=""
UNIFILES_API_LANG_EMBED_0_KEY=""
UNIFILES_API_LANG_EMBED_0_ALIAS=""

# 第二个嵌入模型
UNIFILES_API_LANG_EMBED_1_NAME=""
UNIFILES_API_LANG_EMBED_1_URL=""
UNIFILES_API_LANG_EMBED_1_KEY=""
UNIFILES_API_LANG_EMBED_1_ALIAS=""

# 多模态LLM - Multimodal LLM
UNIFILES_API_MULTIMODAL_0_NAME="Qwen/Qwen2.5-VL-32B-Instruct"
UNIFILES_API_MULTIMODAL_0_URL="https://api.siliconflow.cn/v1/chat/completions"
UNIFILES_API_MULTIMODAL_0_KEY=""
UNIFILES_API_MULTIMODAL_0_ALIAS="Qwen2.5-VL-32B-Instruct"

# 语言LLM - Language LLM
UNIFILES_API_LANG_LLM_0_NAME="Qwen/Qwen3-8B"
UNIFILES_API_LANG_LLM_0_URL="https://api.siliconflow.cn/v1/chat/completions"
UNIFILES_API_LANG_LLM_0_KEY=""
UNIFILES_API_LANG_LLM_0_ALIAS="Qwen/Qwen3-8B"

# =====================================
# 数据库配置 - Database Configuration
# =====================================

# PostgreSQL 数据库 (之前的 pg_vector)
UNIFILES_DB_POSTGRES_ADDRESS=""
UNIFILES_DB_POSTGRES_USER="postgres"
UNIFILES_DB_POSTGRES_PASSWORD="postgres"
UNIFILES_DB_POSTGRES_DATABASE="postgres"
UNIFILES_DB_POSTGRES_ACTIVE="true"

# =====================================
# 存储配置 - Storage Configuration
# =====================================

# MinIO 对象存储
UNIFILES_STORAGE_MINIO_ADDRESS=""
UNIFILES_STORAGE_MINIO_ACCESS_KEY=""
UNIFILES_STORAGE_MINIO_SECRET_KEY=""
UNIFILES_STORAGE_MINIO_BUCKET_NAME=""
UNIFILES_STORAGE_MINIO_REGION=""
UNIFILES_STORAGE_MINIO_PUBLIC_URL_PREFIX=""

# =====================================
# 服务配置 - Service Configuration
# =====================================

# 格式转换服务器 - Format Conversion Server
UNIFILES_SERVICE_CONVERT_0_URL="http://192.168.132.149:7758"
UNIFILES_SERVICE_CONVERT_0_ACTIVE="true"

# OCR 服务 - OCR Services
# Mineru OCR
UNIFILES_SERVICE_OCR_MINERU_0_URL="http://127.0.0.1:8889"
UNIFILES_SERVICE_OCR_MINERU_0_ACTIVE="true"

# Mistral OCR
UNIFILES_SERVICE_OCR_MISTRAL_0_URL=""
UNIFILES_SERVICE_OCR_MISTRAL_0_API_KEY=""
UNIFILES_SERVICE_OCR_MISTRAL_0_ACTIVE="true"

# SelfHosted OCR - OpenAI 兼容格式（支持 vLLM, Qwen3-VL 等）

# 自部署 OCR（单实例，OpenAI 兼容，使用异步 SDK）
UNIFILES_SERVICE_OCR_SELFHOSTED_URL="http://localhost:8012/v1/chat/completions"
UNIFILES_SERVICE_OCR_SELFHOSTED_MODEL="qwen3vl-2b"
UNIFILES_SERVICE_OCR_SELFHOSTED_PROMPT="请识别图片中的所有文字内容，包括表格、列表等结构化内容。请使用 Markdown 格式输出，保持原有的段落结构和格式。"
UNIFILES_SERVICE_OCR_SELFHOSTED_TEMPERATURE="0.7"            
UNIFILES_SERVICE_OCR_SELFHOSTED_MAX_TOKENS="2048"  
# 异步并行处理配置（用于 PDF 多页并发处理）
UNIFILES_SERVICE_OCR_SELFHOSTED_MAX_CONCURRENCY="5"
UNIFILES_SERVICE_OCR_SELFHOSTED_MAX_RETRIES="2"  
UNIFILES_SERVICE_OCR_SELFHOSTED_REQUEST_TIMEOUT="120.0" 

# OpenAI OCR（单实例，使用异步 SDK）
UNIFILES_SERVICE_OCR_OPENAI_URL="https://api.openai.com/v1/chat/completions"
UNIFILES_SERVICE_OCR_OPENAI_API_KEY=""      
UNIFILES_SERVICE_OCR_OPENAI_MODEL="gpt-4o" 
UNIFILES_SERVICE_OCR_OPENAI_PROMPT="Extract all text content from the image and output in Markdown format. Preserve the structure of tables, lists, and other formatted content."

# =====================================
# 日志配置 - Logging Configuration
# =====================================

# 服务名称（用于日志 service 字段）
UNIFILES_SERVICE_NAME="unifiles-v1"

# 日志级别：DEBUG, INFO, WARNING, ERROR
UNIFILES_API_LOG_LEVEL="INFO"

# 日志目录（默认使用项目根目录 logs/）
# 例如：/var/log/unifiles 或 ./logs
UNIFILES_API_LOG_DIR=""

# 文件滚动与保留策略
UNIFILES_API_LOG_ROTATION="100 MB"
UNIFILES_API_LOG_RETENTION="30 days"
UNIFILES_API_LOG_COMPRESSION="zip"

# =====================================
# 策略配置 - Strategy Configuration
# =====================================

# 文本分块策略 - Text Chunking Strategy
UNIFILES_STRATEGY_TEXT_CHUNK_MODULE=""
UNIFILES_STRATEGY_TEXT_CHUNK_SIZE=""
UNIFILES_STRATEGY_TEXT_CHUNK_OVERLAP=""
UNIFILES_STRATEGY_TEXT_CHUNK_TYPE=""
