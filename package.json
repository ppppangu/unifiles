{
  "name": "unifiles-monorepo",
  "private": true,
  "workspaces": [
    "packages/typescript",
    "packages/cli"
  ],
  "scripts": {
    "generate": "uv run python scripts/generate_contract.py",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run build --workspace @wyy/unifiles && npm run typecheck && npm run test && npm run build --workspace @wyy/unifiles-cli"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.41.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
