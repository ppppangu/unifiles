# Include important project files
include README.md
include LICENSE
include CHANGELOG.md
include pyproject.toml

# Include all Python packages
recursive-include unifiles *.py
recursive-include unifiles *.pyi

# Include type stubs
recursive-include unifiles py.typed

# Exclude unnecessary files
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .DS_Store
global-exclude *.so
global-exclude *.dylib

# Exclude test and development files
prune tests
prune docs
prune examples
prune scripts
prune web
prune deploy
prune .github
prune .venv
